# ─── AWS (local via Floci) ────────────────────────────────────────────────────
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ─── DynamoDB ─────────────────────────────────────────────────────────────────
AWS_DYNAMODB_TABLE=fichas-abertura

# ─── S3 ───────────────────────────────────────────────────────────────────────
AWS_S3_BUCKET=prolink-fichas

# ─── SQS ──────────────────────────────────────────────────────────────────────
AWS_SQS_QUEUE_URL=http://localhost:4566/000000000000/prolink-abertura

# ─── SNS ──────────────────────────────────────────────────────────────────────
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:prolink-abertura-emails

# ─── JWT (sessão httpOnly) ────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
SESSION_EXPIRY_SECONDS=7200
