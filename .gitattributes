# Normaliza fim de linha: repo usa LF. Evita que editores no Windows gravem CRLF
# em arquivos que ferramentas (gofmt, eslint) exigem em LF.
* text=auto eol=lf

*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.sh     text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf

*.png    binary
*.jpg    binary
*.pdf    binary
*.ico    binary
