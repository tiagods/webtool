# Copie para .env (ignorado pelo git) ou exporte no shell antes de rodar localmente.

# Segredo HS256 compartilhado entre apps/web (jose) e o backend Go (apps/backend).
# O backend Go FALHA NO BOOT sem esta variavel — nao ha fallback no codigo.
# O docker-compose.yml de dev ja injeta ${JWT_SECRET:-dev-secret-change-in-production}.
JWT_SECRET=dev-secret-change-in-production

# Ambiente do backend Go: dev | prod. Decide a flag Secure do cookie de sessao.
APP_ENV=dev

# SMTP (worker de e-mail) — TODAS obrigatorias: sem default no Compose nem no codigo.
# Ausente = o worker falha no boot e o Compose recusa subir.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=usuario
SMTP_PASSWORD=senha
SMTP_FROM=noreply@example.com
SMTP_TO=destinatario@example.com
