{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SecretsManagerReadInjectedSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:${SECRET_JWT_NAME}-*",
        "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:${SECRET_SMTP_NAME}-*"
      ]
    }
  ]
}
