{
  "name": "prolink-webtool",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f floci",
    "infra:reset": "docker compose down -v && node -e \"for (const f of ['terraform.tfstate','terraform.tfstate.backup']) require('fs').rmSync('scripts/terraform/local/'+f,{force:true})\" && docker compose up -d"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^3.1.1",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "vitest": "^3.1.1"
  }
}
