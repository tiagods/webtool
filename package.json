{
  "name": "prolink-webtool",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "infra:owner": "bash infra/local/stack-owner.sh",
    "infra:up": "bash infra/local/stack-owner.sh --guard && docker compose up -d",
    "infra:down": "bash infra/local/stack-down.sh",
    "infra:logs": "docker compose logs -f floci",
    "infra:reset": "bash infra/local/stack-owner.sh --guard && docker compose down -v && docker compose up -d",
    "infra:validate": "bash infra/local/validate.sh"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^3.1.1",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "vitest": "^3.1.1"
  }
}
